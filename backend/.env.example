# Contract details (Used by the Relayer Backend)
CONTRACT_ADDRESS="YOUR_DEPLOYED_CONTRACT_ADDRESS"
RPC_URL="YOUR_SEPOLIA_RPC_URL" # e.g., https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ADMIN_PRIVATE_KEY="YOUR_METAMASK_PRIVATE_KEY" # The private key of the relayer wallet

# Hardhat Deployment variables (Used only locally to deploy to Sepolia)
SEPOLIA_RPC_URL="YOUR_SEPOLIA_RPC_URL" # Same as RPC_URL above
PRIVATE_KEY="YOUR_METAMASK_PRIVATE_KEY" # Same as ADMIN_PRIVATE_KEY above

# JWT Auth Secret (Used by the Relayer Backend)
JWT_SECRET="production_secret_key"
PORT=5000
