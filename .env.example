# ==============================================================================
# ChainVote — Global Environment Configuration Template
# ==============================================================================

# 1. Database Configuration
# In production, specify a valid PostgreSQL connection URI:
DATABASE_URL="postgres://chainvote_admin:secure_postgres_password_123@localhost:5432/chainvote"
# (If left empty, ChainVote automatically utilizes the embedded SQLite relational engine)

# 2. Blockchain EVM Network Configuration
# Local Hardhat Node:
RPC_URL="http://127.0.0.1:8546"

# Sepolia Testnet (For Cloud / Public Testnet Deployments):
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"

# Deployed Smart Contract Address:
CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"

# Relayer Private Key (Admin Wallet sponsoring gas):
ADMIN_PRIVATE_KEY="0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d"

# 3. Security & Authentication Secrets
JWT_SECRET="chainvote_enterprise_secret_key_change_in_production"
ADMIN_PASSWORD="admin123"

# 4. Networking
PORT=5000
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
